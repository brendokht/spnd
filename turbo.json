{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "stop": {
      "dependsOn": ["^stop"],
      "cache": false,
      "persistent": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@spnd/api#dev": {
      "dependsOn": ["@spnd/supabase#dev"],
      "persistent": true
    },
    "@spnd/web#dev": {
      "dependsOn": ["@spnd/supabase#dev"],
      "persistent": true
    },
    "@spnd/supabase#dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": false
    }
  }
}
