{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "bin/**", "obj/**"],
      "env": ["NODE_ENV"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "cache": true,
      "persistent": false
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "cache": true,
      "persistent": false
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:setup": {
      "dependsOn": ["^build"],
      "cache": true,
      "persistent": false
    },
    "test:ui": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "test:headed": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "stop": {
      "dependsOn": ["^stop"],
      "cache": false,
      "persistent": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@spnd/api#dev": {
      "dependsOn": ["@spnd/supabase#dev"],
      "persistent": true
    },
    "@spnd/web#dev": {
      "dependsOn": ["@spnd/supabase#dev"],
      "persistent": true
    },
    "@spnd/supabase#dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": false
    }
  }
}
