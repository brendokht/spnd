{
  "name": "@spnd/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint --fix --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test:unit": "jest",
    "test:watch": "jest --watch"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun lint --",
      "bun format --"
    ],
    "*.{css,md}": [
      "bun format --"
    ]
  },
  "dependencies": {
    "@spnd/ui": "workspace:*",
    "@supabase/ssr": "^0.9",
    "@supabase/supabase-js": "^2",
    "next": "16.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@spnd/eslint-config": "workspace:*",
    "@spnd/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}
