{
  "name": "@spnd/shared-types",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --fix --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    "./auth": "./src/auth/index.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun lint --",
      "bun format --"
    ],
    "*.{css,md}": [
      "bun format --"
    ]
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@spnd/typescript-config": "workspace:*",
    "@spnd/eslint-config": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
